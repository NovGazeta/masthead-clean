{
  "name": "masthead-clean",
  "title": "THE Журнал",
  "description": "Astro.js Newspaper Starter",
  "type": "module",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "homepage": "https://masthead-clean.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/NovGazeta/masthead-clean"
  },
  "bugs": {
    "url": "https://github.com/NovGazeta/masthead-clean/issues"
  },
  "author": {
    "name": "Denis Glebko",
    "email": "saturnych@gmail.com",
    "url": "https://github.com/Saturnych"
  },
  "scripts": {
    "dev": "astro dev --host --mode development --port 5555",
    "dev:local": "astro dev --mode development --port 5555",
    "build": "astro build",
    "build:local": "prettier . --write && astro build",
    "preview": "astro preview --host --mode development --port 5555",
    "astro": "astro",
    "format": "prettier . --write",
    "playwright": "playwright install",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "db:migrate": "npx tsx scripts/migrate-to-turso.ts",
    "db:backup": "npx tsx scripts/backup-turso.ts --no-r2",
    "db:backup:r2": "npx tsx scripts/backup-turso.ts",
    "db:restore": "npx tsx scripts/restore-turso.ts ./.data/backups/turso/backup-1.sql",
    "db:restore:skip": "npx tsx scripts/restore-turso.ts ./.data/backups/turso/backup-1.sql --skip-fts",
    "db:restore:dry": "npx tsx scripts/restore-turso.ts ./.data/backups/turso/backup-1.sql --dry-run",
    "db:restore:latest:dry": "npx tsx scripts/restore-turso.ts --latest-r2 --dry-run",
    "db:restore:latest:trunc": "npx tsx scripts/restore-turso.ts --latest-r2 --truncate",
    "db:restore:trunc": "npx tsx scripts/restore-turso.ts ./.data/backups/turso/backup-1.sql --truncate",
    "db:restore:trunc:yes": "npx tsx scripts/restore-turso.ts ./.data/backups/turso/backup-1.sql --truncate --yes",
    "db:restore:trunc:dry": "npx tsx scripts/restore-turso.ts ./.data/backups/turso/backup-1.sql --truncate --dry-run",
    "r2:upload": "npx tsx scripts/upload-to-r2.ts ./.data/_assets _assets",
    "r2:upload:ignore": "npx tsx scripts/upload-to-r2.ts ./.data/_assets _assets --ignore-dir tmp,drafts",
    "r2:upload:from": "npx tsx scripts/upload-to-r2.ts ./.data/_assets _assets --from-report ./r2-report.json",
    "r2:upload:dry": "npx tsx scripts/upload-to-r2.ts ./.data/_assets _assets --dry-run --report ./r2-report.json"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.13",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vercel": "^11.0.22",
    "@libsql/client": "^0.18.0",
    "astro": "^7.4.12",
    "gray-matter": "^4.0.3",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "keywords": [
    "astrojs",
    "typescript",
    "markdown"
  ]
}
