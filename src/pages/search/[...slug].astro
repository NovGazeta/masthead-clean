---
import { getAllPosts, getPostWord, type Post } from "@/lib/posts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Pagination from "@/components/Pagination.astro";

const url = Astro.url;
const { slug } = Astro.params;

// Разбираем сегменты пути: /search/[query]/[page]
// Например: slug = "москва/2" -> query = "москва", page = 2
const segments = slug ? slug.split("/").map((s) => decodeURIComponent(s)) : [];
const query = segments.length > 0 ? segments[0].trim() : "";

let currentPage = 1;

if (segments.length > 1 && segments[1]) {
  const parsed = parseInt(segments[1], 10);
  if (!isNaN(parsed) && parsed > 0) {
    currentPage = parsed;
  }
}

const RESULTS_PER_PAGE = 10;

interface SearchResult {
  post: Post;
  titleHtml: string;
  snippetHtml: string;
}

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function escapeRegExp(str: string): string {
  return str.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function stripMarkdown(md: string): string {
  if (!md) return "";
  return md
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/`[^`]*`/g, " ")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
    .replace(/[#>*_~-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function highlightTerms(text: string, terms: string[]): string {
  if (!terms.length) return escapeHtml(text);
  const pattern = new RegExp(`(${terms.map(escapeRegExp).join("|")})`, "gi");
  const parts = text.split(pattern);
  return parts
    .map((part, idx) => (idx % 2 === 1 ? `<mark>${escapeHtml(part)}</mark>` : escapeHtml(part)))
    .join("");
}

function buildSnippet(plainText: string, terms: string[], maxLength = 220): string {
  if (!plainText) return "";
  const lower = plainText.toLowerCase();
  let firstMatchIdx = -1;

  for (const term of terms) {
    const idx = lower.indexOf(term.toLowerCase());
    if (idx !== -1 && (firstMatchIdx === -1 || idx < firstMatchIdx)) {
      firstMatchIdx = idx;
    }
  }

  let start = 0;
  if (firstMatchIdx > 60) {
    start = Math.max(0, firstMatchIdx - 60);
    const nextSpace = plainText.indexOf(" ", start);
    if (nextSpace !== -1 && nextSpace < firstMatchIdx) {
      start = nextSpace + 1;
    }
  }

  let slice = plainText.slice(start, start + maxLength);
  if (start + maxLength < plainText.length) {
    const lastSpace = slice.lastIndexOf(" ");
    if (lastSpace > maxLength * 0.6) {
      slice = slice.slice(0, lastSpace);
    }
    slice += "…";
  }
  if (start > 0) {
    slice = "…" + slice;
  }

  return highlightTerms(slice, terms);
}

let allMatches: SearchResult[] = [];

try {
  const allPosts = await getAllPosts();

  if (query.length > 0 && allPosts && allPosts.length > 0) {
    const terms = Array.from(
      new Set(
        query
          .toLowerCase()
          .split(/\s+/)
          .map((t) => t.trim())
          .filter((t) => t.length > 0),
      ),
    );

    for (const post of allPosts) {
      const rawBody = (post as any).content || (post as any).body || "";
      const plainBody = stripMarkdown(rawBody);

      const authorsList = Array.isArray(post.authors) ? post.authors : [];
      const tagsList = Array.isArray(post.tags) ? post.tags : [];

      const searchable = [
        post.title || "",
        post.subtitle || "",
        post.description || "",
        post.rubric || "",
        ...authorsList,
        ...tagsList,
        plainBody,
      ]
        .join(" ")
        .toLowerCase();

      const isMatch = terms.every((term) => searchable.includes(term));

      if (isMatch) {
        const sourceText = post.subtitle || post.description || plainBody || post.title || "";
        allMatches.push({
          post,
          titleHtml: highlightTerms(post.title || "Без названия", terms),
          snippetHtml: buildSnippet(sourceText, terms),
        });
      }
    }
  }
} catch (e) {
  console.error("Search error:", e);
}

const totalResults = allMatches.length;
const totalPages = Math.max(1, Math.ceil(totalResults / RESULTS_PER_PAGE));
const safePage = Math.min(currentPage, totalPages);

const startIndex = (safePage - 1) * RESULTS_PER_PAGE;
const paginatedResults = allMatches.slice(startIndex, startIndex + RESULTS_PER_PAGE);

// Базовый путь для пагинации поиска в ЧПУ формате: /search/запрос
const searchBasePath = query ? `/search/${encodeURIComponent(query)}` : "/search";

if (!import.meta.env.DEV)
  Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=300");
else Astro.response.headers.set("Cache-Control", "public, s-maxage=1, stale-while-revalidate=1");
---

<BaseLayout
  title={query ? `Поиск: «${query}» — THE Журнал` : "Поиск по изданию — THE Журнал"}
  description="Поиск по материалам, рубрикам, авторам и тегам издания"
>
  <section class="search-page">
    <header class="search-header">
      <span class="meta-label">Архивный указатель</span>
      <h1>Поиск по материалам</h1>

      <form id="search-form" class="search-form" role="search">
        <input
          type="search"
          id="search-input"
          name="q"
          value={query}
          placeholder="Введите ключевое слово, фамилию автора или тему…"
          aria-label="Поисковый запрос"
          autofocus
        />
        <button type="submit" class="meta-label">
          Найти
        </button>
      </form>

      <script>
        const form = document.getElementById("search-form") as HTMLFormElement;
        const input = document.getElementById("search-input") as HTMLInputElement;

        if (form && input) {
          form.addEventListener("submit", (e) => {
            e.preventDefault();
            const query = input.value.trim();
            if (query) {
              window.location.href = `/search/${encodeURIComponent(query)}`;
            }
          });
        }
      </script>

      {query && (
        <p class="search-status meta-label">
          {totalResults > 0
            ? `По запросу «${query}» найдено: ${totalResults} ${getPostWord(totalResults)}`
            : `По запросу «${query}» ничего не найдено`}
        </p>
      )}
    </header>

    {query && paginatedResults.length > 0 && (
      <>
        <ul class="results-list">
          {paginatedResults.map(({ post, titleHtml, snippetHtml }) => {
            const pubDateObj = post.pubDate ? new Date(post.pubDate) : new Date();
            const formattedDate = !isNaN(pubDateObj.getTime())
              ? pubDateObj.toLocaleDateString("ru-RU", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                })
              : "";

            return (
              <li class="result-item">
                <div class="result-meta">
                  {post.rubric && <span class="category-tag">{post.rubric}</span>}
                  {formattedDate && (
                    <time class="meta-label" datetime={pubDateObj.toISOString()}>
                      {formattedDate}
                    </time>
                  )}
                  {post.readingTime && (
                    <span class="meta-label result-reading">{post.readingTime}</span>
                  )}
                </div>

                <h2 class="result-title">
                  <a href={`/articles/${post.slug}`} set:html={titleHtml} />
                </h2>

                {snippetHtml && <p class="result-snippet" set:html={snippetHtml} />}
              </li>
            );
          })}
        </ul>

        <Pagination
          currentPage={safePage}
          totalPages={totalPages}
          basePath={searchBasePath}
          ariaLabel="Пагинация результатов поиска"
        />
      </>
    )}

    {query && totalResults === 0 && (
      <div class="empty-results">
        <p>
          Попробуйте изменить формулировку запроса или обратиться к{" "}
          <a href="/archive">хронологическому архиву</a>.
        </p>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("search-form") as HTMLFormElement;
  const input = document.getElementById("search-input") as HTMLInputElement;

  if (form && input) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const query = input.value.trim();
      if (query) {
        window.location.href = `/search/${encodeURIComponent(query)}`;
      }
    });
  }
</script>

<style>
  .search-page {
    max-width: 820px;
    margin: 0 auto;
    padding-bottom: 4rem;
  }

  .search-header {
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border-dark);
    margin-bottom: 2.5rem;
  }

  .search-header h1 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 500;
    line-height: 1.1;
    margin: 0.5rem 0 1.5rem;
    letter-spacing: -0.02em;
  }

  .search-form {
    display: flex;
    gap: 0.75rem;
  }

  .search-form input[type="search"] {
    flex: 1;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-dark);
    background-color: var(--surface-color);
    color: var(--text-primary);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .search-form input[type="search"]:focus {
    border-color: var(--accent-color);
  }

  .search-form button {
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--border-dark);
    background-color: var(--border-dark);
    color: var(--accent-color);
    cursor: pointer;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .search-form button:hover {
    opacity: 0.9;
  }

  .search-status {
    margin-top: 1.25rem;
    color: var(--text-secondary);
  }

  .results-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .result-item {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .result-item:first-child {
    padding-top: 0;
  }

  .result-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  .result-reading {
    color: var(--text-secondary);
  }

  .result-title {
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }

  .result-title a {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .result-title a:hover {
    color: var(--accent-color);
    opacity: 1;
  }

  .result-snippet {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  .result-title :global(mark),
  .result-snippet :global(mark) {
    background-color: color-mix(in srgb, var(--accent-color) 22%, transparent);
    color: inherit;
    padding: 0.05em 0.2em;
    border-radius: 2px;
  }

  .empty-results {
    padding: 2rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  .empty-results a {
    color: var(--accent-color);
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .search-form {
      flex-direction: column;
    }
  }
</style>
