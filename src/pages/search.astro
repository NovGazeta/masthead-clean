---
import { searchPosts } from "../lib/posts";
import BaseLayout from "../layouts/BaseLayout.astro";

const query = Astro.url.searchParams.get("q") ?? "";
const results = query ? await searchPosts(query) : [];
---

<BaseLayout title={query ? `Поиск: ${query}` : "Поиск по архиву"}>
  <section class="search-section">
    <header class="search-header">
      <span class="meta-label">Поиск по материалам издания</span>
      <h1>Архивный поиск</h1>

      <form action="/search" method="get" class="search-page-form">
        <input
          type="search"
          name="q"
          value={query}
          placeholder="Введите слово, тему или имя автора..."
          aria-label="Поисковый запрос"
          autofocus={!query}
        />
        <button type="submit" class="meta-label">
          Найти
        </button>
      </form>
    </header>

    {query && (
      <div class="results-meta">
        <span class="meta-label">
          {results.length > 0
            ? `Найдено публикаций по запросу «${query}»: ${results.length}`
            : `По запросу «${query}» ничего не найдено`}
        </span>
      </div>
    )}

    {results.length > 0 ? (
      <div class="search-results-list">
        {results.map((post) => {
          const formattedDate = post.pubDate.toLocaleDateString("ru-RU", {
            day: "numeric",
            month: "long",
            year: "numeric",
          });

          return (
            <article class="search-result-item">
              <div class="result-body">
                <span class="category-tag">{post.category}</span>
                <h2>
                  <a href={`/posts/${post.slug}`}>{post.title}</a>
                </h2>
                <p class="snippet" set:html={post.snippetHtml} />
                <div class="meta-label">
                  {post.author} &bull; {formattedDate}
                </div>
              </div>

              {post.image && (
                <a href={`/posts/${post.slug}`} class="result-thumb">
                  <img src={post.image} alt={post.title} loading="lazy" />
                </a>
              )}
            </article>
          );
        })}
      </div>
    ) : (
      query && (
        <div class="empty-search">
          <p>
            Попробуйте изменить формулировку, использовать более общие слова или перейти в одну из
            рубрик.
          </p>
        </div>
      )
    )}
  </section>
</BaseLayout>

<style>
  .search-section {
    max-width: 860px;
    margin: 0 auto;
  }

  .search-header {
    border-bottom: 2px solid var(--border-dark);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .search-header h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    margin: 0.35rem 0 1.5rem;
  }

  .search-page-form {
    display: flex;
    max-width: 620px;
    border: 1px solid var(--border-dark);
    background-color: var(--bg-color);
  }

  .search-page-form input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 0.85rem 1rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--text-primary);
    outline: none;
  }

  .search-page-form input::placeholder {
    color: var(--text-secondary);
    font-style: italic;
  }

  .search-page-form button {
    background-color: var(--border-dark);
    color: var(--bg-color);
    border: none;
    padding: 0 1.5rem;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .search-page-form button:hover {
    opacity: 0.85;
  }

  .results-meta {
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .search-results-list {
    display: flex;
    flex-direction: column;
  }

  .search-result-item {
    display: grid;
    grid-template-columns: 1fr 180px;
    gap: 2rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border-color);
    align-items: center;
  }

  .search-result-item:last-child {
    border-bottom: none;
  }

  .result-body h2 {
    font-size: 1.55rem;
    font-weight: 500;
    line-height: 1.25;
    margin: 0.4rem 0 0.75rem;
  }

  .snippet {
    color: var(--text-secondary);
    font-size: 1.02rem;
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  /* Стилизация подсветки найденного слова (светлая и темная тема) */
  .snippet :global(mark) {
    background-color: rgba(139, 38, 29, 0.14);
    color: var(--accent-color);
    font-weight: 600;
    padding: 0.05em 0.25em;
    border-radius: 2px;
  }

  :global([data-theme="dark"]) .snippet :global(mark) {
    background-color: rgba(217, 91, 78, 0.22);
    color: #f38b80;
  }

  .result-thumb img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    display: block;
  }

  .empty-search {
    padding: 2rem 0;
    color: var(--text-secondary);
    font-style: italic;
    font-size: 1.15rem;
  }

  @media (max-width: 650px) {
    .search-result-item {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .result-thumb {
      order: -1;
    }

    .result-thumb img {
      height: 180px;
    }

    .search-page-form {
      flex-direction: column;
    }

    .search-page-form button {
      padding: 0.85rem;
    }
  }
</style>
