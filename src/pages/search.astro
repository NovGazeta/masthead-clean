---
import { searchPosts, paginateItems } from "../lib/posts";
import BaseLayout from "../layouts/BaseLayout.astro";
import Pagination from "../components/Pagination.astro";

const query = Astro.url.searchParams.get("q") || "";
const pageParam = Number(Astro.url.searchParams.get("page") || "1");

const allResults = query ? await searchPosts(query) : [];
const paginated = paginateItems(allResults, pageParam, 6);
---

<BaseLayout
  title={query ? `Поиск: ${query}` : "Поиск по сайту"}
  description="Результаты поиска по архиву публикаций The Masthead"
>
  <section class="search-page">
    <header class="search-header">
      <span class="meta-label">Архивный индекс</span>
      <h1>Поиск по материалам</h1>

      <form action="/search" method="get" class="search-box" role="search">
        <input
          type="search"
          name="q"
          value={query}
          placeholder="Введите ключевое слово, тему или автора..."
          required
          autofocus
          class="meta-label search-input"
          aria-label="Запрос для поиска"
        />
        <button type="submit" class="search-submit meta-label">
          Найти
        </button>
      </form>
    </header>

    {query && (
      <div class="search-results-area">
        <div class="results-meta meta-label">
          {allResults.length > 0 ? (
            <>
              Найдено совпадений: {allResults.length}
              {paginated.totalPages > 1 &&
                ` • Страница ${paginated.currentPage} из ${paginated.totalPages}`}
            </>
          ) : (
            `По запросу «${query}» ничего не найдено`
          )}
        </div>

        {paginated.items.length > 0 ? (
          <div class="results-list">
            {paginated.items.map((post) => {
              const formattedDate = post.pubDate.toLocaleDateString("ru-RU", {
                day: "numeric",
                month: "long",
                year: "numeric",
              });

              return (
                <article class="search-item">
                  <div class="search-item-meta">
                    <span class="category-tag">{post.category}</span>
                    <span class="meta-label">
                      {post.author} &bull; {formattedDate} &bull; {post.readingTime}
                    </span>
                  </div>

                  <h2>
                    <a href={`/articles/${post.slug}`}>{post.title}</a>
                  </h2>

                  <p class="search-snippet" set:html={post.snippetHtml} />
                </article>
              );
            })}
          </div>
        ) : (
          <div class="empty-search">
            <p>Попробуйте изменить формулировку запроса или использовать более общие термины.</p>
          </div>
        )}

        <Pagination
          currentPage={paginated.currentPage}
          totalPages={paginated.totalPages}
          basePath="/search"
          queryParams={{ q: query }}
          ariaLabel="Пагинация архива"
        />
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .search-page {
    max-width: 780px;
    margin: 0 auto;
  }

  .search-header {
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--border-dark);
    margin-bottom: 2.5rem;
  }

  .search-header h1 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 500;
    line-height: 1.12;
    margin: 0.4rem 0 1.5rem;
    letter-spacing: -0.02em;
  }

  .search-box {
    display: flex;
    border: 1px solid var(--border-dark);
    background-color: var(--surface-color);
  }

  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--text-primary);
    padding: 0.85rem 1rem;
    font-size: 1.05rem;
    font-family: var(--font-sans);
    outline: none;
  }

  .search-input::placeholder {
    color: var(--text-secondary);
  }

  .search-submit {
    background-color: var(--border-dark);
    color: var(--bg-color);
    border: none;
    padding: 0 1.75rem;
    cursor: pointer;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .search-submit:hover {
    opacity: 0.85;
  }

  .results-meta {
    margin-bottom: 2rem;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.6rem;
  }

  .results-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .search-item {
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--border-color);
  }

  .search-item-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .search-item h2 {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }

  .search-item h2 a:hover {
    color: var(--accent-color);
    opacity: 1;
  }

  .search-snippet {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .search-snippet :global(mark) {
    background-color: var(--accent-color);
    color: var(--bg-color);
    padding: 0 0.2rem;
  }

  .empty-search {
    padding: 2rem 0;
    color: var(--text-secondary);
    font-style: italic;
  }

  @media (max-width: 600px) {
    .search-box {
      flex-direction: column;
    }

    .search-submit {
      padding: 0.75rem;
      width: 100%;
    }
  }
</style>
