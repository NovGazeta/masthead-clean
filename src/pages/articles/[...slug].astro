---
import { getAllPosts, getPostBySlug, slugifyTag, parseAuthors } from "@/lib/posts";
import { applyAssetBaseUrlToHtml, resolveAssetUrl, toAbsoluteAssetUrl } from "@/lib/assets";
import { toSlug } from "@/lib/translit";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const post = await getPostBySlug(decodeURIComponent(slug));

if (!post) {
  return Astro.redirect("/404");
}

const {
  title,
  subtitle,
  pubDate,
  rubric,
  genre,
  source,
  image,
  imageCaption,
  readingTime,
  toc,
  htmlContent,
} = post;

const authors = Array.isArray(post.authors) ? post.authors : parseAuthors(post.authors);
const primaryAuthorName = authors[0]?.name;

const validPubDate =
  pubDate instanceof Date && !Number.isNaN(pubDate.getTime()) ? pubDate : new Date();

const formattedDate = validPubDate.toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const baseUrl = (Astro.site?.toString() || Astro.url.origin).replace(/\/$/, "");
const postUrl = new URL(`/articles/${encodeURIComponent(post.slug)}`, baseUrl).toString();
const isoDate = validPubDate.toISOString();

const telegramShareUrl = `https://t.me/share/url?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(title)}`;
const xShareUrl = `https://x.com/intent/tweet?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(title)}`;
const facebookShareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(postUrl)}`;

const rawCoverImage = image || post.images?.[0]?.url;
const coverImageUrl = resolveAssetUrl(rawCoverImage);
const absoluteImageUrl = rawCoverImage ? toAbsoluteAssetUrl(rawCoverImage, baseUrl) : undefined;
const renderedHtml = applyAssetBaseUrlToHtml(htmlContent);

const articleJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: subtitle || post.plainText.slice(0, 160),
  datePublished: isoDate,
  dateModified: isoDate,
  articleSection: rubric,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": source || postUrl,
  },
  ...(primaryAuthorName
    ? {
        author: {
          "@type": "Person",
          name: primaryAuthorName,
        },
      }
    : {}),
  publisher: {
    "@type": "Organization",
    name: "THE Журнал",
    url: baseUrl,
  },
  ...(absoluteImageUrl ? { image: [absoluteImageUrl] } : {}),
};

const allPosts = await getAllPosts();
const otherPosts = allPosts.filter((p) => p.slug !== post.slug);

const sameRubricPosts = otherPosts.filter(
  (p) => p.rubric.trim().toLowerCase() === rubric.trim().toLowerCase(),
);

const fallbackPosts = otherPosts.filter(
  (p) => p.rubric.trim().toLowerCase() !== rubric.trim().toLowerCase(),
);

const relatedPosts = [...sameRubricPosts, ...fallbackPosts].slice(0, 3);

if (!import.meta.env.DEV) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=3600, stale-while-revalidate=86400",
  );
} else {
  Astro.response.headers.set("Cache-Control", "public, s-maxage=1, stale-while-revalidate=1");
}
---

<BaseLayout
  title={title}
  description={subtitle || post.plainText.slice(0, 160)}
  image={rawCoverImage}
  imageAlt={imageCaption || title}
  type="article"
  publishedTime={isoDate}
  author={primaryAuthorName}
  section={rubric}
  jsonLd={articleJsonLd}
>
  <!-- Индикатор прогресса чтения -->
  <div class="reading-progress-track" aria-hidden="true">
    <div id="reading-progress-bar" class="reading-progress-bar"></div>
  </div>

  <article id="post-article" class="post-article">
    <header class="post-header">
      <div class="post-meta-top">
        <span class="category-tag">{rubric}</span>
        {genre && <span class="genre-badge meta-label">{genre}</span>}
      </div>

      <h1>{title}</h1>
      {subtitle && <p class="lead">{subtitle}</p>}

      <div class="meta-label byline">
        Текст:{" "}
        {authors?.length > 0 &&
          authors.map((author, idx) => (
            <>
              <a href={`/author/${author.slug || toSlug(author.name)}`} class="author-byline-link">
                {author.name}
              </a>
              {idx < authors.length - 1 && ", "}
            </>
          ))}{" "}
        &bull; Опубликовано: {formattedDate} &bull; {readingTime}
      </div>
    </header>

    {coverImageUrl && (
      <figure class="post-hero">
        <img src={coverImageUrl} alt={imageCaption || title} />
        {imageCaption && <figcaption class="meta-label">{imageCaption}</figcaption>}
      </figure>
    )}

    <!-- Оглавление статьи (выводится при наличии 2 и более подзаголовков) -->
    {toc && toc.length >= 2 && (
      <nav class="toc-box" aria-label="Содержание статьи">
        <span class="meta-label toc-heading">Содержание</span>
        <ol class="toc-list">
          {toc.map((item) => (
            <li class={`toc-item toc-level-${item.level}`}>
              <a href={`#${item.id}`}>{item.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose" set:html={renderedHtml} />

    {post.tags && post.tags.length > 0 && (
      <div class="article-tags-bar">
        <span class="meta-label">Теги:</span>
        <div class="tags-list">
          {post.tags.map((tag) => (
            <a href={`/tag/${slugifyTag(tag)}`} class="meta-label tag-link">
              #{tag}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Панель шеринга и копирования ссылки -->
    <footer class="share-bar" aria-label="Поделиться публикацией">
      <span class="meta-label share-title">Поделиться материалом в:</span>

      <div class="share-actions">
        <a
          href={telegramShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn share-icon-btn"
          aria-label="Поделиться в Telegram"
          title="Поделиться в Telegram"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </a>

        <a
          href={xShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn share-icon-btn"
          aria-label="Поделиться в X"
          title="Поделиться в X"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>

        <a
          href={facebookShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn share-icon-btn"
          aria-label="Поделиться в Facebook"
          title="Поделиться в Facebook"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
          </svg>
        </a>

        <button
          id="copy-link-btn"
          type="button"
          class="share-btn meta-label"
          data-url={postUrl}
          aria-label="Скопировать ссылку на статью"
          title="Скопировать ссылку"
        >
          <svg
            class="icon-copy"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg
            class="icon-check"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span id="copy-link-label">Скопировать ссылку</span>
        </button>
      </div>
    </footer>
  </article>

  {relatedPosts.length > 0 && (
    <section class="related-section" aria-labelledby="related-heading">
      <div class="related-header">
        <span id="related-heading" class="meta-label">
          Читайте также
        </span>
      </div>

      <div class="related-grid">
        {relatedPosts.map((related) => (
          <ArticleCard post={related} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // 1. Индикатор прогресса чтения
  const article = document.getElementById("post-article");
  const progressBar = document.getElementById("reading-progress-bar");

  let ticking = false;

  function updateReadingProgress() {
    if (article && progressBar) {
      const rect = article.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const articleTop = window.scrollY + rect.top;
      const totalScrollable = article.offsetHeight - windowHeight * 0.6;

      if (totalScrollable <= 0) {
        progressBar.style.transform = "scaleX(1)";
      } else {
        const currentProgress = (window.scrollY - articleTop) / totalScrollable;
        const clamped = Math.min(1, Math.max(0, currentProgress));
        progressBar.style.transform = `scaleX(${clamped})`;
      }
    }

    ticking = false;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(updateReadingProgress);
        ticking = true;
      }
    },
    { passive: true },
  );

  window.addEventListener("resize", updateReadingProgress, { passive: true });
  updateReadingProgress();

  // 2. Копирование ссылки в буфер обмена
  const copyBtn = document.getElementById("copy-link-btn");
  const copyLabel = document.getElementById("copy-link-label");
  let resetTimer: number | undefined;

  copyBtn?.addEventListener("click", async () => {
    const urlToCopy = copyBtn.getAttribute("data-url") || window.location.href;

    try {
      await navigator.clipboard.writeText(urlToCopy);
    } catch {
      const tempInput = document.createElement("input");
      tempInput.value = urlToCopy;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand("copy");
      document.body.removeChild(tempInput);
    }

    copyBtn.classList.add("is-copied");
    if (copyLabel) {
      copyLabel.textContent = "Ссылка скопирована";
    }

    window.clearTimeout(resetTimer);
    resetTimer = window.setTimeout(() => {
      copyBtn.classList.remove("is-copied");
      if (copyLabel) {
        copyLabel.textContent = "Скопировать ссылку";
      }
    }, 2500);
  });
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .reading-progress-track {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: transparent;
    z-index: 1000;
    pointer-events: none;
  }

  .reading-progress-bar {
    width: 100%;
    height: 100%;
    background-color: var(--accent-color);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.08s linear;
  }

  .post-article {
    max-width: 740px;
    margin: 0 auto;
  }

  .post-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .post-meta-top {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .genre-badge {
    color: var(--text-secondary);
    background-color: var(--surface-color);
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border-color);
  }

  .post-header h1 {
    font-size: clamp(1.85rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.15;
    margin: 0.75rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .lead {
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    color: var(--text-secondary);
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .byline {
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 0.75rem 0;
  }

  .post-hero {
    margin-bottom: 2.5rem;
  }

  .post-hero img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
  }

  .post-hero figcaption {
    margin-top: 0.5rem;
    text-align: right;
  }

  /* Блок оглавления в редакционном стиле */
  .toc-box {
    margin-bottom: 2.5rem;
    padding: 1.25rem 1.5rem;
    border-top: 2px solid var(--border-dark);
    border-bottom: 1px solid var(--border-dark);
    background-color: var(--surface-color);
  }

  .toc-heading {
    display: block;
    margin-bottom: 0.85rem;
    color: var(--text-secondary);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .toc-item a {
    font-family: var(--font-serif);
    font-size: 1.02rem;
    line-height: 1.45;
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .toc-item a:hover {
    color: var(--accent-color);
    border-bottom-color: var(--accent-color);
    opacity: 1;
  }

  .toc-level-3 {
    padding-left: 1.25rem;
    position: relative;
  }

  .toc-level-3::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .toc-level-3 a {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .prose {
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose :global(p:first-of-type::first-letter) {
    float: left;
    font-size: 3.6rem;
    line-height: 0.85;
    padding-right: 0.6rem;
    padding-top: 0.2rem;
    font-weight: 500;
  }

  .prose :global(h2) {
    font-size: 1.65rem;
    font-weight: 500;
    margin: 2.5rem 0 1rem;
    scroll-margin-top: 1.5rem;
  }

  .prose :global(h3) {
    font-size: 1.3rem;
    font-weight: 500;
    margin: 2rem 0 0.75rem;
    scroll-margin-top: 1.5rem;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--border-dark);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--text-secondary);
    margin: 2rem 0;
  }

  /* Панель шеринга */
  .share-bar {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .share-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    height: 36px;
    padding: 0 0.85rem;
    border: 1px solid var(--border-color);
    background-color: transparent;
    color: var(--text-primary);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .share-icon-btn {
    width: 36px;
    padding: 0;
  }

  .share-btn:hover {
    border-color: var(--border-dark);
    background-color: var(--surface-color);
    opacity: 1;
  }

  .share-btn .icon-check {
    display: none;
  }

  .share-btn.is-copied {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .share-btn.is-copied .icon-copy {
    display: none;
  }

  .share-btn.is-copied .icon-check {
    display: inline-block;
  }

  /* Блок «Читайте также» */
  .related-section {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 2px solid var(--border-dark);
  }

  .related-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.6rem;
    margin-bottom: 2rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .post-header {
      text-align: left;
      margin-bottom: 1.75rem;
    }

    .post-meta-top {
      justify-content: flex-start;
    }

    .post-hero {
      margin-bottom: 1.75rem;
    }

    .post-hero img {
      max-height: 260px;
    }

    .toc-box {
      padding: 1rem 1.15rem;
      margin-bottom: 2rem;
    }

    .prose {
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .prose :global(p:first-of-type::first-letter) {
      font-size: 3rem;
    }

    .share-bar {
      flex-direction: column;
      align-items: flex-start;
    }

    .share-actions {
      width: 100%;
    }

    #copy-link-btn {
      flex: 1;
    }

    .related-section {
      margin-top: 3rem;
      padding-top: 1.5rem;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Ограничение максимальных размеров для любых изображений в контенте статьи */
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 2rem auto;
    border: 1px solid var(--border-color);
  }
</style>
