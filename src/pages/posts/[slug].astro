---
import { getAllPosts, getPostBySlug } from "../../lib/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const post = await getPostBySlug(slug);

if (!post) {
  return Astro.redirect("/404");
}

const {
  title,
  description,
  pubDate,
  author,
  category,
  image,
  imageCaption,
  readingTime,
  htmlContent,
} = post;

const formattedDate = pubDate.toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

// Подбор до 3 рекомендаций из кэша
const allPosts = await getAllPosts();
const otherPosts = allPosts.filter((p) => p.slug !== post.slug);

// 1. Сначала статьи из той же рубрики
const sameCategoryPosts = otherPosts.filter(
  (p) => p.category.trim().toLowerCase() === category.trim().toLowerCase(),
);

// 2. Если в рубрике меньше 3 статей, добираем свежими из других рубрик
const fallbackPosts = otherPosts.filter(
  (p) => p.category.trim().toLowerCase() !== category.trim().toLowerCase(),
);

const relatedPosts = [...sameCategoryPosts, ...fallbackPosts].slice(0, 3);
---

<BaseLayout title={title} description={description}>
  <article class="post-article">
    <header class="post-header">
      <span class="category-tag">{category}</span>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="meta-label byline">
        Текст: {author} &bull; Опубликовано: {formattedDate} &bull; {readingTime}
      </div>
    </header>

    {image && (
      <figure class="post-hero">
        <img src={image} alt={title} />
        {imageCaption && <figcaption class="meta-label">{imageCaption}</figcaption>}
      </figure>
    )}

    <div class="prose" set:html={htmlContent} />
  </article>

  {relatedPosts.length > 0 && (
    <section class="related-section" aria-labelledby="related-heading">
      <div class="related-header">
        <span id="related-heading" class="meta-label">
          Читайте также
        </span>
      </div>

      <div class="related-grid">
        {relatedPosts.map((related) => (
          <ArticleCard post={related} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .post-article {
    max-width: 740px;
    margin: 0 auto;
  }

  .post-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .post-header h1 {
    font-size: clamp(1.85rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.15;
    margin: 0.75rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .lead {
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    color: var(--text-secondary);
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .byline {
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 0.75rem 0;
  }

  .post-hero {
    margin-bottom: 2.5rem;
  }

  .post-hero img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
  }

  .post-hero figcaption {
    margin-top: 0.5rem;
    text-align: right;
  }

  .prose {
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose :global(p:first-of-type::first-letter) {
    float: left;
    font-size: 3.6rem;
    line-height: 0.85;
    padding-right: 0.6rem;
    padding-top: 0.2rem;
    font-weight: 500;
  }

  .prose :global(h2) {
    font-size: 1.65rem;
    font-weight: 500;
    margin: 2.5rem 0 1rem;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--border-dark);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--text-secondary);
    margin: 2rem 0;
  }

  /* Блок «Читайте также» на всю ширину контейнера */
  .related-section {
    margin-top: 4.5rem;
    padding-top: 2rem;
    border-top: 2px solid var(--border-dark);
  }

  .related-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.6rem;
    margin-bottom: 2rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .post-header {
      text-align: left;
      margin-bottom: 1.75rem;
    }

    .post-hero {
      margin-bottom: 1.75rem;
    }

    .post-hero img {
      max-height: 260px;
    }

    .prose {
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .prose :global(p:first-of-type::first-letter) {
      font-size: 3rem;
    }

    .related-section {
      margin-top: 3rem;
      padding-top: 1.5rem;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
