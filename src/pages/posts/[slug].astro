---
import { getAllPosts, getPostBySlug } from "../../lib/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const post = await getPostBySlug(slug);

if (!post) {
  return Astro.redirect("/404");
}

const {
  title,
  description,
  pubDate,
  author,
  category,
  image,
  imageCaption,
  readingTime,
  htmlContent,
} = post;

const formattedDate = pubDate.toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const baseUrl = (Astro.site?.toString() || Astro.url.origin).replace(/\/$/, "");
const postUrl = new URL(`/posts/${encodeURIComponent(post.slug)}`, baseUrl).toString();
const isoDate = pubDate.toISOString();

// Ссылка для шеринга в Telegram
const telegramShareUrl = `https://t.me/share/url?url=${encodeURIComponent(postUrl)}&text=${encodeURIComponent(title)}`;

const absoluteImageUrl = image
  ? image.startsWith("http://") || image.startsWith("https://")
    ? image
    : new URL(image.startsWith("/") ? image : `/${image}`, baseUrl).toString()
  : undefined;

const articleJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description,
  datePublished: isoDate,
  dateModified: isoDate,
  articleSection: category,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
  author: {
    "@type": "Person",
    name: author,
  },
  publisher: {
    "@type": "Organization",
    name: "THE MASTHEAD",
    url: baseUrl,
  },
  ...(absoluteImageUrl ? { image: [absoluteImageUrl] } : {}),
};

const allPosts = await getAllPosts();
const otherPosts = allPosts.filter((p) => p.slug !== post.slug);

const sameCategoryPosts = otherPosts.filter(
  (p) => p.category.trim().toLowerCase() === category.trim().toLowerCase(),
);

const fallbackPosts = otherPosts.filter(
  (p) => p.category.trim().toLowerCase() !== category.trim().toLowerCase(),
);

const relatedPosts = [...sameCategoryPosts, ...fallbackPosts].slice(0, 3);
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  publishedTime={isoDate}
  author={author}
  section={category}
  jsonLd={articleJsonLd}
>
  <!-- Индикатор прогресса чтения -->
  <div class="reading-progress-track" aria-hidden="true">
    <div id="reading-progress-bar" class="reading-progress-bar"></div>
  </div>

  <article id="post-article" class="post-article">
    <header class="post-header">
      <span class="category-tag">{category}</span>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="meta-label byline">
        Текст: {author} &bull; Опубликовано: {formattedDate} &bull; {readingTime}
      </div>
    </header>

    {image && (
      <figure class="post-hero">
        <img src={image} alt={title} />
        {imageCaption && <figcaption class="meta-label">{imageCaption}</figcaption>}
      </figure>
    )}

    <div class="prose" set:html={htmlContent} />

    <!-- Панель шеринга и копирования ссылки -->
    <footer class="share-bar" aria-label="Поделиться публикацией">
      <span class="meta-label share-title">Поделиться материалом</span>

      <div class="share-actions">
        <a
          href={telegramShareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="share-btn meta-label"
          aria-label="Поделиться в Telegram"
        >
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          <span>Telegram</span>
        </a>

        <button
          id="copy-link-btn"
          type="button"
          class="share-btn meta-label"
          data-url={postUrl}
          aria-label="Скопировать ссылку на статью"
        >
          <svg
            class="icon-copy"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg
            class="icon-check"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span id="copy-link-label">Скопировать ссылку</span>
        </button>
      </div>
    </footer>
  </article>

  {relatedPosts.length > 0 && (
    <section class="related-section" aria-labelledby="related-heading">
      <div class="related-header">
        <span id="related-heading" class="meta-label">
          Читайте также
        </span>
      </div>

      <div class="related-grid">
        {relatedPosts.map((related) => (
          <ArticleCard post={related} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // 1. Индикатор прогресса чтения
  const article = document.getElementById("post-article");
  const progressBar = document.getElementById("reading-progress-bar");

  let ticking = false;

  function updateReadingProgress() {
    if (article && progressBar) {
      const rect = article.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const articleTop = window.scrollY + rect.top;
      const totalScrollable = article.offsetHeight - windowHeight * 0.6;

      if (totalScrollable <= 0) {
        progressBar.style.transform = "scaleX(1)";
      } else {
        const currentProgress = (window.scrollY - articleTop) / totalScrollable;
        const clamped = Math.min(1, Math.max(0, currentProgress));
        progressBar.style.transform = `scaleX(${clamped})`;
      }
    }

    ticking = false;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(updateReadingProgress);
        ticking = true;
      }
    },
    { passive: true },
  );

  window.addEventListener("resize", updateReadingProgress, { passive: true });
  updateReadingProgress();

  // 2. Копирование ссылки в буфер обмена
  const copyBtn = document.getElementById("copy-link-btn");
  const copyLabel = document.getElementById("copy-link-label");
  let resetTimer: number | undefined;

  copyBtn?.addEventListener("click", async () => {
    const urlToCopy = copyBtn.getAttribute("data-url") || window.location.href;

    try {
      await navigator.clipboard.writeText(urlToCopy);
    } catch {
      // Резервный способ для старых браузеров или HTTP без HTTPS
      const tempInput = document.createElement("input");
      tempInput.value = urlToCopy;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand("copy");
      document.body.removeChild(tempInput);
    }

    copyBtn.classList.add("is-copied");
    if (copyLabel) {
      copyLabel.textContent = "Ссылка скопирована";
    }

    window.clearTimeout(resetTimer);
    resetTimer = window.setTimeout(() => {
      copyBtn.classList.remove("is-copied");
      if (copyLabel) {
        copyLabel.textContent = "Скопировать ссылку";
      }
    }, 2500);
  });
</script>

<style>
  .reading-progress-track {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background-color: transparent;
    z-index: 1000;
    pointer-events: none;
  }

  .reading-progress-bar {
    width: 100%;
    height: 100%;
    background-color: var(--accent-color);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.08s linear;
  }

  .post-article {
    max-width: 740px;
    margin: 0 auto;
  }

  .post-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .post-header h1 {
    font-size: clamp(1.85rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.15;
    margin: 0.75rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .lead {
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    color: var(--text-secondary);
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .byline {
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 0.75rem 0;
  }

  .post-hero {
    margin-bottom: 2.5rem;
  }

  .post-hero img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
  }

  .post-hero figcaption {
    margin-top: 0.5rem;
    text-align: right;
  }

  .prose {
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose :global(p:first-of-type::first-letter) {
    float: left;
    font-size: 3.6rem;
    line-height: 0.85;
    padding-right: 0.6rem;
    padding-top: 0.2rem;
    font-weight: 500;
  }

  .prose :global(h2) {
    font-size: 1.65rem;
    font-weight: 500;
    margin: 2.5rem 0 1rem;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--border-dark);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--text-secondary);
    margin: 2rem 0;
  }

  /* Минималистичная панель шеринга */
  .share-bar {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .share-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--border-color);
    background-color: transparent;
    color: var(--text-primary);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .share-btn:hover {
    border-color: var(--border-dark);
    background-color: var(--surface-color);
    opacity: 1;
  }

  .share-btn .icon-check {
    display: none;
  }

  .share-btn.is-copied {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .share-btn.is-copied .icon-copy {
    display: none;
  }

  .share-btn.is-copied .icon-check {
    display: inline-block;
  }

  /* Блок «Читайте также» */
  .related-section {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 2px solid var(--border-dark);
  }

  .related-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.6rem;
    margin-bottom: 2rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .post-header {
      text-align: left;
      margin-bottom: 1.75rem;
    }

    .post-hero {
      margin-bottom: 1.75rem;
    }

    .post-hero img {
      max-height: 260px;
    }

    .prose {
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .prose :global(p:first-of-type::first-letter) {
      font-size: 3rem;
    }

    .share-bar {
      flex-direction: column;
      align-items: flex-start;
    }

    .share-actions {
      width: 100%;
    }

    .share-btn {
      flex: 1;
      justify-content: center;
    }

    .related-section {
      margin-top: 3rem;
      padding-top: 1.5rem;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
