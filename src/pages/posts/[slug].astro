---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, pubDate, author, category, image, imageCaption } = post.data;

const formattedDate = pubDate.toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title={title} description={description}>
  <article class="post-article">
    <header class="post-header">
      <span class="category-tag">{category}</span>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="meta-label byline">
        Текст: {author} &bull; Опубликовано: {formattedDate}
      </div>
    </header>

    {image && (
      <figure class="post-hero">
        <img src={image} alt={title} />
        {imageCaption && <figcaption class="meta-label">{imageCaption}</figcaption>}
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-article {
    max-width: 740px;
    margin: 0 auto;
  }

  .post-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .post-header h1 {
    font-size: clamp(1.85rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.15;
    margin: 0.75rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .lead {
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    color: var(--text-secondary);
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .byline {
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 0.75rem 0;
  }

  .post-hero {
    margin-bottom: 2.5rem;
  }

  .post-hero img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
  }

  .post-hero figcaption {
    margin-top: 0.5rem;
    text-align: right;
  }

  .prose {
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .prose :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose :global(p:first-of-type::first-letter) {
    float: left;
    font-size: 3.6rem;
    line-height: 0.85;
    padding-right: 0.6rem;
    padding-top: 0.2rem;
    font-weight: 500;
  }

  .prose :global(h2) {
    font-size: 1.65rem;
    font-weight: 500;
    margin: 2.5rem 0 1rem;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--border-dark);
    padding-left: 1.25rem;
    font-style: italic;
    color: var(--text-secondary);
    margin: 2rem 0;
  }

  @media (max-width: 600px) {
    .post-header {
      text-align: left;
      margin-bottom: 1.75rem;
    }

    .post-hero {
      margin-bottom: 1.75rem;
    }

    .post-hero img {
      max-height: 260px;
    }

    .prose {
      font-size: 1.05rem;
      line-height: 1.7;
    }

    .prose :global(p:first-of-type::first-letter) {
      font-size: 3rem;
    }
  }
</style>
