---
import { getPostsByTag, paginateItems } from "@/lib/posts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Pagination from "@/components/Pagination.astro";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const segments = slug ? slug.split("/") : [];
const tagSlug = segments.length > 0 ? segments[0] : undefined;
if (!tagSlug) return Astro.redirect("/404");

let currentPage = 1;

if (segments.length > 1 && segments[1]) {
  const parsedPage = parseInt(segments[1], 10);
  if (!isNaN(parsedPage) && parsedPage > 1) {
    currentPage = parsedPage;
  }
}

const ARTICLES_PER_PAGE = 12;

const tagPosts = await getPostsByTag(tagSlug);
if (!tagPosts) return Astro.redirect("/404");

const { tagName, posts } = tagPosts;
if (!posts) return Astro.redirect("/404");

const totalPosts = posts.length;
const totalPages = Math.max(1, Math.ceil(totalPosts / ARTICLES_PER_PAGE));

// Если запросили несуществующую страницу за пределами диапазона — 404
if (currentPage > totalPages) {
  return new Response(null, { status: 404 });
}

const startIndex = (currentPage - 1) * ARTICLES_PER_PAGE;
const paginatedPosts = posts.slice(startIndex, startIndex + ARTICLES_PER_PAGE);

if (!import.meta.env.DEV)
  Astro.response.headers.set("Cache-Control", "public, s-maxage=60, stale-while-revalidate=300");
else Astro.response.headers.set("Cache-Control", "public, s-maxage=1, stale-while-revalidate=1");
---

<BaseLayout
  title={`Тег: ${tagName}`}
  description={`Все публикации с тегом «${tagName}» в журнале The Журнал`}
>
  <section class="tag-page">
    <header class="tag-header">
      <span class="meta-label">Метка архива</span>
      <h1>#{tagName}</h1>
      <p class="meta-label">
        Материалов по тегу: {posts.length}
        {totalPages > 1 && ` • Страница ${currentPage} из ${totalPages}`}
      </p>
    </header>

    <div class="articles-grid">
      {paginatedPosts.map((post) => (
        <ArticleCard post={post} />
      ))}
    </div>

    <Pagination currentPage={currentPage} totalPages={totalPages} basePath={`/tag/${tagSlug}`} />
  </section>
</BaseLayout>

<style>
  .tag-header {
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--border-dark);
    margin-bottom: 2.5rem;
  }

  .tag-header h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 500;
    margin: 0.4rem 0 0.6rem;
    letter-spacing: -0.02em;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  @media (max-width: 900px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
