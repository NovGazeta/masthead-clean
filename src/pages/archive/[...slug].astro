---
import { turso } from "@/lib/turso";
import { getFullUrl, type Post } from "@/lib/posts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Pagination from "@/components/Pagination.astro";

const MONTH_NAMES = [
  "Январь",
  "Февраль",
  "Март",
  "Апрель",
  "Май",
  "Июнь",
  "Июль",
  "Август",
  "Сентябрь",
  "Октябрь",
  "Ноябрь",
  "Декабрь",
];

interface MonthGroup {
  monthIndex: number;
  monthName: string;
  posts: Post[];
}

// 1. Получаем список доступных годов по убыванию напрямую из БД
const yearsRes = await turso.execute(`
  SELECT DISTINCT CAST(strftime('%Y', COALESCE(pub_date, date)) AS INTEGER) as year
  FROM posts
  WHERE draft = 0
  ORDER BY year DESC;
`);

const allYears = yearsRes.rows
  .map((r: any) => Number(r.year))
  .filter((y) => Number.isFinite(y) && y > 0);

const defaultYear = allYears[0] ?? new Date().getFullYear();

// Парсим параметры из URL сегментов ([...slug])
// Ожидаемые варианты: без параметров, ["2026"], ["2026", "2"]
const { slug } = Astro.params;
const segments = slug ? slug.split("/") : [];

let selectedYear = defaultYear;
let currentPage = 1;

if (segments.length > 0 && segments[0]) {
  const parsedYear = parseInt(segments[0], 10);
  if (allYears.includes(parsedYear)) {
    selectedYear = parsedYear;
  }
}

if (segments.length > 1 && segments[1]) {
  const parsedPage = parseInt(segments[1], 10);
  if (!isNaN(parsedPage) && parsedPage > 1) {
    currentPage = parsedPage;
  }
}

const POSTS_PER_PAGE = 20;

// Запрашиваем только посты выбранного года и считаем их количество в SQL
const yearStartIso = `${selectedYear}-01-01T00:00:00.000Z`;
const yearEndIso = `${selectedYear + 1}-01-01T00:00:00.000Z`;

const yearCountRes = await turso.execute({
  sql: `
    SELECT COUNT(*) as total
    FROM posts
    WHERE draft = 0
      AND COALESCE(pub_date, date) >= ?
      AND COALESCE(pub_date, date) < ?;
  `,
  args: [yearStartIso, yearEndIso],
});

const totalPostsInYear = Number(yearCountRes.rows[0]?.total ?? 0);
const totalPages = Math.max(1, Math.ceil(totalPostsInYear / POSTS_PER_PAGE));
const safePage = Math.min(currentPage, totalPages);
const offset = (safePage - 1) * POSTS_PER_PAGE;

const yearSliceRes = await turso.execute({
  sql: `
    SELECT
      p.id,
      p.slug,
      p.title,
      p.subtitle,
      p.pub_date,
      p.date,
      p.reading_time,
      p.content,
      r.name as rubric_name
    FROM posts p
    LEFT JOIN rubrics r ON p.rubric_id = r.id
    WHERE p.draft = 0
      AND COALESCE(p.pub_date, p.date) >= ?
      AND COALESCE(p.pub_date, p.date) < ?
    ORDER BY COALESCE(p.pub_date, p.date) DESC
    LIMIT ? OFFSET ?;
  `,
  args: [yearStartIso, yearEndIso, POSTS_PER_PAGE, offset],
});

const paginatedPosts: Post[] = yearSliceRes.rows.map((row: any) => {
  const plain = String(row.content || "")
    .replace(/[#>*_`~\[\]()!-]/g, " ")
    .replace(/\s+/g, " ")
    .trim();

  return {
    id: Number(row.id),
    slug: String(row.slug),
    title: String(row.title),
    subtitle: row.subtitle ? String(row.subtitle) : undefined,
    pubDate: new Date(row.pub_date || row.date),
    authors: [],
    rubric: row.rubric_name ? String(row.rubric_name) : "",
    tags: [],
    readingTime: row.reading_time
      ? String(row.reading_time)
      : `${Math.max(1, Math.ceil(plain.split(/\s+/).filter(Boolean).length / 180))} мин чтения`,
    htmlContent: "",
    plainText: plain,
  };
});

// Группируем по месяцам
const monthMap = new Map<number, Post[]>();
for (const post of paginatedPosts) {
  const month = post.pubDate.getMonth();
  if (!monthMap.has(month)) {
    monthMap.set(month, []);
  }
  monthMap.get(month)!.push(post);
}

const months: MonthGroup[] = Array.from(monthMap.entries())
  .sort(([monthA], [monthB]) => monthB - monthA)
  .map(([monthIndex, monthPosts]) => ({
    monthIndex,
    monthName: MONTH_NAMES[monthIndex],
    posts: monthPosts,
  }));

function pluralizeIssues(count: number): string {
  const mod10 = count % 10;
  const mod100 = count % 100;
  if (mod10 === 1 && mod100 !== 11) return `${count} публикация`;
  if (mod10 >= 2 && mod10 <= 4 && (mod100 < 10 || mod100 >= 20)) {
    return `${count} публикации`;
  }
  return `${count} публикаций`;
}

// Генератор путей для страниц архива (чтобы передать в универсальный Pagination)
const getArchiveBasePath = (year: number) => `/archive/${year}`;

if (!import.meta.env.DEV)
  Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=3600, stale-while-revalidate=86400",
  );
else Astro.response.headers.set("Cache-Control", "public, s-maxage=1, stale-while-revalidate=1");
---

<BaseLayout
  title={`Архив выпусков — ${selectedYear}`}
  description={`Хронологическая подшивка публикаций издания The Masthead за ${selectedYear} год`}
>
  <section class="archive-page">
    <header class="archive-header">
      <span class="meta-label">Хронологическая подшивка</span>
      <h1>Архив выпусков</h1>
      <p class="archive-subtitle">
        Полный каталог материалов издания, систематизированный по году выхода.
      </p>

      {allYears.length > 0 && (
        <nav class="year-jumps" aria-label="Выбор года выпуска">
          <span class="meta-label">Годы выпуска:</span>
          <div class="year-pills">
            {allYears.map((y) => (
              <a
                href={`/archive/${y}`}
                class={`year-pill meta-label ${y === selectedYear ? "is-active" : ""}`}
                aria-current={y === selectedYear ? "true" : undefined}
              >
                {y}
              </a>
            ))}
          </div>
          <span class="meta-label total-badge">
            Всего за {selectedYear} год: {pluralizeIssues(totalPostsInYear)}
          </span>
        </nav>
      )}
    </header>

    {months.length === 0 ? (
      <div class="empty-archive">
        <p>За {selectedYear} год нет опубликованных материалов.</p>
      </div>
    ) : (
      <div class="archive-timeline">
        <section class="year-section">
          <div class="year-banner">
            <h2>{selectedYear}</h2>
            <span class="meta-label">
              Страница {safePage} из {totalPages}
            </span>
          </div>

          <div class="months-stack">
            {months.map((monthGroup) => (
              <div class="month-block">
                <div class="month-sidebar">
                  <h3 class="month-title">{monthGroup.monthName}</h3>
                  <span class="meta-label month-count">
                    {pluralizeIssues(monthGroup.posts.length)}
                  </span>
                </div>

                <ul class="issues-list">
                  {monthGroup.posts.map((post) => {
                    const day = String(post.pubDate.getDate()).padStart(2, "0");
                    const monthNum = String(post.pubDate.getMonth() + 1).padStart(2, "0");
                    const excerpt = post.subtitle || post.plainText;

                    return (
                      <li class="issue-row">
                        <time class="issue-date meta-label" datetime={post.pubDate.toISOString()}>
                          {day}.{monthNum}
                        </time>

                        <div class="issue-body">
                          <div class="issue-headline-line">
                            <a href={getFullUrl(post.slug)} class="issue-link">
                              {post.title}
                            </a>
                          </div>
                          {excerpt && <p class="issue-excerpt">{excerpt}</p>}
                        </div>

                        <div class="issue-meta">
                          <span class="category-tag">{post.rubric}</span>
                          <span class="meta-label issue-reading-time">{post.readingTime}</span>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <Pagination
          currentPage={safePage}
          totalPages={totalPages}
          basePath={getArchiveBasePath(selectedYear)}
          ariaLabel="Пагинация архива"
        />
      </div>
    )}
  </section>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .archive-page {
    max-width: 980px;
    margin: 0 auto;
    padding-bottom: 4rem;
  }

  .archive-header {
    padding-bottom: 1.75rem;
    border-bottom: 2px solid var(--border-dark);
    margin-bottom: 3rem;
  }

  .archive-header h1 {
    font-size: clamp(2.1rem, 5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.1;
    margin: 0.5rem 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .archive-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    font-style: italic;
    max-width: 640px;
  }

  .year-jumps {
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .year-pills {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .year-pill {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .year-pill:hover {
    border-color: var(--border-dark);
    opacity: 1;
  }

  .year-pill.is-active {
    background-color: var(--border-dark);
    color: var(--accent-color);
    border-color: var(--border-dark);
    font-weight: 500;
  }

  .total-badge {
    margin-left: auto;
    color: var(--text-secondary);
  }

  .archive-timeline {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .year-banner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 2px solid var(--border-dark);
    padding-bottom: 0.5rem;
    margin-bottom: 2rem;
  }

  .year-banner h2 {
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .months-stack {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .month-block {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2rem;
    align-items: start;
  }

  .month-sidebar {
    position: sticky;
    top: 1.5rem;
    padding-top: 0.25rem;
  }

  .month-title {
    font-size: 1.35rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .month-count {
    display: block;
    color: var(--text-secondary);
  }

  .issues-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border-color);
  }

  .issue-row {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 1.25rem;
    align-items: baseline;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--border-color);
  }

  .issue-date {
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
  }

  .issue-link {
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .issue-link:hover {
    color: var(--accent-color);
    opacity: 1;
  }

  .issue-excerpt {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-top: 0.3rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .issue-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3rem;
    text-align: right;
    white-space: nowrap;
  }

  .issue-reading-time {
    color: var(--text-secondary);
    font-size: 0.7rem;
  }

  .empty-archive {
    padding: 3rem 0;
    text-align: center;
    color: var(--text-secondary);
    font-style: italic;
  }

  @media (max-width: 820px) {
    .month-block {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .month-sidebar {
      position: static;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
  }

  @media (max-width: 600px) {
    .total-badge {
      margin-left: 0;
      width: 100%;
    }

    .issue-row {
      grid-template-columns: 48px 1fr;
      gap: 0.75rem;
    }

    .issue-meta {
      grid-column: 2;
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      gap: 0.75rem;
      margin-top: 0.2rem;
    }
  }
</style>
