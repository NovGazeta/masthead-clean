---
import { getAllPosts } from "../../lib/posts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

const categoryMap: Record<string, string> = {
  culture: "Культура",
  technology: "Технологии",
  essays: "Эссе",
  design: "Дизайн",
};

const { category } = Astro.params;
const label = category ? categoryMap[category.toLowerCase()] : undefined;

if (!label) {
  return Astro.redirect("/404");
}

const allPosts = await getAllPosts();
const posts = allPosts.filter((p) => p.category.trim().toLowerCase() === label.toLowerCase());
---

<BaseLayout title={`Рубрика: ${label}`}>
  <div class="cat-header">
    <span class="meta-label">Архив рубрики</span>
    <h1>{label}</h1>
  </div>

  {posts.length > 0 ? (
    <div class="articles-grid">
      {posts.map((post) => (
        <ArticleCard post={post} />
      ))}
    </div>
  ) : (
    <p class="empty-state">В этой рубрике пока нет опубликованных материалов.</p>
  )}
</BaseLayout>

<style>
  .cat-header {
    border-bottom: 2px solid var(--border-dark);
    padding-bottom: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .cat-header h1 {
    font-size: 2.5rem;
    font-weight: 500;
    margin-top: 0.25rem;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .empty-state {
    color: var(--text-secondary);
    font-style: italic;
    font-size: 1.15rem;
  }

  @media (max-width: 900px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
