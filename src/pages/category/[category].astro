---
import { getAllPosts, paginateItems } from "@/lib/posts";
import { fromSlug } from "@/lib/translit";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Pagination from "../../components/Pagination.astro";

const { category } = Astro.params;
const categoryName = category ? fromSlug(category) : undefined;

if (!categoryName) {
  return Astro.redirect("/404");
}

const allPosts = await getAllPosts();
const categoryPosts = allPosts.filter(
  (post) => post.rubric.trim().toLowerCase() === categoryName.toLowerCase(),
);

const pageParam = Number(Astro.url.searchParams.get("page") || "1");
const paginated = paginateItems(categoryPosts, pageParam, 9);
---

<BaseLayout title={categoryName} description={`Все публикации в рубрике «${categoryName}»`}>
  <section class="category-page">
    <header class="category-header">
      <span class="meta-label">Рубрика</span>
      <h1>{categoryName}</h1>
      <p class="meta-label">
        Материалов в разделе: {categoryPosts.length}
        {paginated.totalPages > 1 &&
          ` • Страница ${paginated.currentPage} из ${paginated.totalPages}`}
      </p>
    </header>

    {paginated.items.length === 0 ? (
      <p class="empty-msg">В этой рубрике пока нет публикаций.</p>
    ) : (
      <>
        <div class="articles-grid">
          {paginated.items.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>

        <Pagination
          currentPage={paginated.currentPage}
          totalPages={paginated.totalPages}
          baseUrl={Astro.url.pathname + Astro.url.search}
        />
      </>
    )}
  </section>
</BaseLayout>

<style>
  .category-header {
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--border-dark);
    margin-bottom: 2.5rem;
  }

  .category-header h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 500;
    margin: 0.4rem 0 0.6rem;
    letter-spacing: -0.02em;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .empty-msg {
    color: var(--text-secondary);
    font-style: italic;
  }

  @media (max-width: 900px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
