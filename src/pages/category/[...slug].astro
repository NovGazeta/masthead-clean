---
import { getAllPosts, paginateItems } from "@/lib/posts";
import { fromSlug, toSlug } from "@/lib/translit";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import Pagination from "@/components/Pagination.astro";

const { slug } = Astro.params;
const segments = slug ? slug.split("/") : [];

const categoryName = segments.length > 0 ? fromSlug(segments[0]) : undefined;

if (!categoryName) {
  return Astro.redirect("/404");
}

let currentPage = 1;

if (segments.length > 1 && segments[1]) {
  const parsedPage = parseInt(segments[1], 10);
  if (!isNaN(parsedPage) && parsedPage > 1) {
    currentPage = parsedPage;
  }
}

const ARTICLES_PER_PAGE = 12;

const allPosts = await getAllPosts();
const categoryPosts = allPosts.filter(
  (post) => post.rubric.trim().toLowerCase() === categoryName.toLowerCase(),
);

const totalPosts = categoryPosts.length;
const totalPages = Math.max(1, Math.ceil(totalPosts / ARTICLES_PER_PAGE));

// Если запросили несуществующую страницу за пределами диапазона — 404
if (currentPage > totalPages) {
  return new Response(null, { status: 404 });
}

const startIndex = (currentPage - 1) * ARTICLES_PER_PAGE;
const paginatedPosts = categoryPosts.slice(startIndex, startIndex + ARTICLES_PER_PAGE);
---

<BaseLayout title={categoryName} description={`Все публикации в рубрике «${categoryName}»`}>
  <section class="category-page">
    <header class="category-header">
      <span class="meta-label">Рубрика</span>
      <h1>{categoryName}</h1>
      <p class="meta-label">
        Материалов в разделе: {categoryPosts.length}
        {totalPages > 1 && ` • Страница ${currentPage} из ${totalPages}`}
      </p>
    </header>

    {paginatedPosts.length === 0 ? (
      <p class="empty-msg">В этой рубрике пока нет публикаций.</p>
    ) : (
      <>
        <div class="articles-grid">
          {paginatedPosts.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>

        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          basePath={`/category/${toSlug(categoryName)}`}
        />
      </>
    )}
  </section>
</BaseLayout>

<style>
  .category-header {
    padding-bottom: 1.5rem;
    border-bottom: 2px solid var(--border-dark);
    margin-bottom: 2.5rem;
  }

  .category-header h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 500;
    margin: 0.4rem 0 0.6rem;
    letter-spacing: -0.02em;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .empty-msg {
    color: var(--text-secondary);
    font-style: italic;
  }

  @media (max-width: 900px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
