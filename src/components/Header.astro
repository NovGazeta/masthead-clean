---
const today = new Date().toLocaleDateString("ru-RU", {
  weekday: "short",
  year: "numeric",
  month: "long",
  day: "numeric",
});

const pathname = Astro.url.pathname;

// Нормализуем путь (убираем завершающий слэш для точного сравнения)
const normalizePath = (path: string) =>
  path.endsWith("/") && path.length > 1 ? path.slice(0, -1) : path;
const currentPath = normalizePath(pathname);

const isActive = (slug: string) => {
  const normalizedSlug = normalizePath(slug);
  return currentPath === normalizedSlug;
};

// Служебные ссылки
const utilityLinks = [
  { name: "Главная", slug: "/" },
  { name: "О проекте", slug: "/about" },
];

// Тематические рубрики
const categories = [
  { name: "Культура", slug: "/category/culture" },
  { name: "Технологии", slug: "/category/technology" },
  { name: "Эссе", slug: "/category/essays" },
  { name: "Дизайн", slug: "/category/design" },
];
---

<header class="masthead">
  <div class="container">
    <!-- Верхняя служебная панель -->
    <div class="top-bar">
      <div class="top-left">
        <span class="meta-label">{today}</span>
        <span class="meta-label issue-num">&bull; Выпуск № 42</span>
      </div>

      <div class="top-actions">
        <!-- Служебные ссылки (десктоп) -->
        <nav class="utility-nav" aria-label="Служебная навигация">
          {utilityLinks.map((link) => (
            <a href={link.slug} class={`meta-label ${isActive(link.slug) ? "active" : ""}`}>
              {link.name}
            </a>
          ))}
        </nav>

        <!-- Переключатель темной темы -->
        <button
          id="theme-toggle"
          class="icon-btn"
          type="button"
          aria-label="Переключить тему"
          title="Сменить тему оформления"
        >
          <svg
            class="icon-sun"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg
            class="icon-moon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <!-- Кнопка мобильного меню (бургер) -->
        <button
          id="mobile-menu-toggle"
          class="mobile-menu-btn icon-btn"
          type="button"
          aria-expanded="false"
          aria-controls="main-nav"
          aria-label="Меню навигации"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <line x1="3" y1="7" x2="21" y2="7"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="17" x2="21" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Логотип издания -->
    <div class="brand-area">
      <a href="/" class="logo">
        THE MASTHEAD
      </a>
      <p class="tagline">Журнал о цифровом ремесле, культуре и медленном чтении</p>
    </div>

    <!-- Десктопная навигация под логотипом -->
    <nav class="desktop-nav" aria-label="Рубрики">
      <ul>
        {categories.map((cat) => (
          <li>
            <a href={cat.slug} class={`meta-label ${isActive(cat.slug) ? "active" : ""}`}>
              {cat.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Мобильное выпадающее меню -->
    <nav id="main-nav" class="mobile-nav" aria-label="Мобильное меню">
      <ul>
        {utilityLinks.map((link) => (
          <li class="mobile-utility-item">
            <a href={link.slug} class={`meta-label ${isActive(link.slug) ? "active" : ""}`}>
              {link.name}
            </a>
          </li>
        ))}
        {categories.map((cat) => (
          <li>
            <a href={cat.slug} class={`meta-label ${isActive(cat.slug) ? "active" : ""}`}>
              {cat.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const themeToggle = document.getElementById("theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme");
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
  });

  const menuToggle = document.getElementById("mobile-menu-toggle");
  const mobileNav = document.getElementById("main-nav");

  menuToggle?.addEventListener("click", () => {
    const isOpen = mobileNav?.classList.toggle("is-open");
    menuToggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>

<style>
  .masthead {
    padding-top: 1rem;
    margin-bottom: 2.5rem;
  }

  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
    gap: 1rem;
  }

  .top-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .top-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .utility-nav {
    display: flex;
    gap: 1.25rem;
  }

  /* Стили ссылок и активного состояния */
  .utility-nav a,
  .desktop-nav a,
  .mobile-nav a {
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .desktop-nav a {
    color: var(--text-primary);
  }

  .utility-nav a:hover,
  .utility-nav a.active,
  .desktop-nav a:hover,
  .desktop-nav a.active,
  .mobile-nav a:hover,
  .mobile-nav a.active {
    color: var(--accent-color);
    opacity: 1;
  }

  .icon-btn {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .icon-btn:hover {
    border-color: var(--border-dark);
    background-color: var(--surface-color);
  }

  :global([data-theme="light"]) .icon-sun,
  :global(:root:not([data-theme="dark"])) .icon-sun {
    display: none;
  }

  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }

  .mobile-menu-btn {
    display: none;
  }

  .brand-area {
    text-align: center;
    padding: 2.25rem 0;
    border-bottom: 2px solid var(--border-dark);
  }

  .logo {
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 6.5vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    display: block;
  }

  .tagline {
    font-style: italic;
    color: var(--text-secondary);
    margin-top: 0.65rem;
    font-size: clamp(0.92rem, 2.5vw, 1.05rem);
  }

  /* Десктопная навигация */
  .desktop-nav {
    border-bottom: 2px solid var(--border-dark);
    padding: 0.75rem 0;
  }

  .desktop-nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2rem;
  }

  /* Мобильная навигация скрыта на десктопе */
  .mobile-nav {
    display: none;
  }

  /* Медиа-запрос для мобильных устройств (до 768px) */
  @media (max-width: 768px) {
    .masthead {
      margin-bottom: 1.75rem;
    }

    .issue-num,
    .utility-nav,
    .desktop-nav {
      display: none !important;
    }

    .mobile-menu-btn {
      display: inline-flex !important;
    }

    .brand-area {
      padding: 1.5rem 0;
    }

    .mobile-nav {
      display: none;
      border-bottom: 2px solid var(--border-dark);
      padding: 0;
    }

    .mobile-nav.is-open {
      display: block;
    }

    .mobile-nav ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .mobile-nav li {
      border-bottom: 1px solid var(--border-color);
    }

    .mobile-nav li:last-child {
      border-bottom: none;
    }

    .mobile-utility-item {
      background-color: var(--surface-color);
    }

    .mobile-nav a {
      display: block;
      padding: 0.85rem 0.25rem;
      color: var(--text-primary);
    }
  }
</style>
