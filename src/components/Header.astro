---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: "Главная", href: "/" },
  { label: "Культура", href: "/category/culture" },
  { label: "Технологии", href: "/category/technology" },
  { label: "Эссе", href: "/category/essays" },
  { label: "Дизайн", href: "/category/design" },
  { label: "Архив", href: "/archive" },
  { label: "О проекте", href: "/about" },
];

const today = new Date().toLocaleDateString("ru-RU", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<header class="site-header">
  <div class="container">
    <!-- Верхняя полоса: дата выпуска, поиск и переключатель темы -->
    <div class="top-bar">
      <span class="meta-label issue-date">{today}</span>

      <div class="top-controls">
        <a
          href="/search"
          class:list={["control-btn meta-label", { active: currentPath === "/search" }]}
          aria-label="Поиск по сайту"
          title="Поиск"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="control-text">Поиск</span>
        </a>

        <button
          id="theme-toggle"
          type="button"
          class="control-btn meta-label"
          aria-label="Переключить цветовую тему"
          title="Сменить тему"
        >
          <svg
            class="icon-sun"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg
            class="icon-moon"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span class="control-text" id="theme-label">
            Тема
          </span>
        </button>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="control-btn mobile-only meta-label"
          aria-expanded="false"
          aria-controls="main-nav"
          aria-label="Открыть меню"
        >
          <svg
            class="icon-menu"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg
            class="icon-close"
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          <span>Меню</span>
        </button>
      </div>
    </div>

    <!-- Газетная шапка (Masthead) -->
    <div class="masthead">
      <a href="/" class="brand">
        THE MASTHEAD
      </a>
      <p class="tagline">Журнал о цифровом ремесле, культуре и медленном чтении</p>
    </div>

    <!-- Навигация по рубрикам и разделам -->
    <nav id="main-nav" class="main-nav" aria-label="Основная навигация">
      <ul class="nav-list">
        {navItems.map((item) => {
          const isActive =
            item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href);

          return (
            <li>
              <a
                href={item.href}
                class:list={["nav-link meta-label", { active: isActive }]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Переключение светлой и тёмной темы
  const themeToggle = document.getElementById("theme-toggle");
  const themeLabel = document.getElementById("theme-label");

  function syncThemeLabel() {
    const isDark = document.documentElement.getAttribute("data-theme") === "dark";
    if (themeLabel) {
      themeLabel.textContent = isDark ? "Светлая" : "Тёмная";
    }
  }

  syncThemeLabel();

  themeToggle?.addEventListener("click", () => {
    const current = document.documentElement.getAttribute("data-theme");
    const next = current === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    localStorage.setItem("theme", next);
    syncThemeLabel();
  });

  // Мобильное меню
  const menuToggle = document.getElementById("mobile-menu-toggle");
  const mainNav = document.getElementById("main-nav");

  menuToggle?.addEventListener("click", () => {
    const isOpen = mainNav?.classList.toggle("is-open");
    menuToggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
    menuToggle.classList.toggle("is-active", Boolean(isOpen));
  });
</script>

<style>
  .site-header {
    margin-bottom: 3rem;
  }

  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border-color);
    gap: 1rem;
  }

  .top-controls {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .control-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--text-primary);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .control-btn:hover,
  .control-btn.active {
    border-color: var(--border-dark);
    background-color: var(--surface-color);
    opacity: 1;
  }

  /* Иконки темы */
  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }

  :global(:not([data-theme="dark"])) .icon-sun {
    display: none;
  }

  .mobile-only {
    display: none;
  }

  .icon-close {
    display: none;
  }

  .mobile-only.is-active .icon-menu {
    display: none;
  }

  .mobile-only.is-active .icon-close {
    display: inline-block;
  }

  /* Логотип издания */
  .masthead {
    text-align: center;
    padding: 2.25rem 0 1.75rem;
  }

  .brand {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
    display: inline-block;
  }

  .brand:hover {
    opacity: 1;
  }

  .tagline {
    margin-top: 0.65rem;
    font-size: 1rem;
    font-style: italic;
    color: var(--text-secondary);
  }

  /* Навигационная полоса */
  .main-nav {
    border-top: 2px solid var(--border-dark);
    border-bottom: 1px solid var(--border-dark);
    padding: 0.8rem 0;
  }

  .nav-list {
    list-style: none;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: var(--text-primary);
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--accent-color);
    opacity: 1;
  }

  .nav-link.active {
    color: var(--accent-color);
    border-bottom-color: var(--accent-color);
  }

  @media (max-width: 768px) {
    .site-header {
      margin-bottom: 2rem;
    }

    .issue-date {
      display: none;
    }

    .top-bar {
      justify-content: flex-end;
    }

    .mobile-only {
      display: inline-flex;
    }

    .masthead {
      padding: 1.5rem 0 1.25rem;
    }

    .main-nav {
      display: none;
      padding: 1rem 0;
    }

    .main-nav.is-open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }
  }
</style>
