---
import type { Post } from "@/lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { slug, title, description, pubDate, author, category, image, readingTime } = post;

const formattedDate = pubDate?.toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<article class="featured-grid">
  <div class="featured-content">
    <span class="category-tag">{category}</span>
    <h1>
      <a href={`/articles/${slug}`}>{title}</a>
    </h1>
    <p class="excerpt">{description}</p>
    <div class="meta-label">
      Автор: <a href={`/author/${post.authorSlug}`}>{author}</a> &mdash; {formattedDate} &bull;{" "}
      {readingTime}
    </div>
  </div>

  {image && (
    <a href={`/articles/${slug}`} class="featured-image">
      <img src={image} alt={title} />
    </a>
  )}
</article>

<style>
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border-color);
    align-items: center;
  }

  .featured-content h1 {
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    font-weight: 500;
    line-height: 1.15;
    margin: 0.75rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .excerpt {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .featured-image img {
    width: 100%;
    height: 400px;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 820px) {
    .featured-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-bottom: 2rem;
    }
    .featured-image {
      order: -1;
    }
    .featured-image img {
      height: 240px;
    }
  }
</style>
