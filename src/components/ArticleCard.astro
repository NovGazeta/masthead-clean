---
import type { Post } from "@/lib/posts";
import { parseAuthors } from "@/lib/posts";

interface Props {
  post: Post;
  featured?: boolean;
  hideAuthors?: boolean;
}

const { post, featured = false, hideAuthors = false } = Astro.props;

const authors = hideAuthors
  ? []
  : Array.isArray(post.authors)
    ? post.authors
    : parseAuthors(post.authors);

const parsedDate =
  post.pubDate instanceof Date ? post.pubDate : new Date(post.pubDate as unknown as string);
const validDate = !Number.isNaN(parsedDate.getTime()) ? parsedDate : new Date();

const formattedDate = validDate.toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const excerpt =
  post.subtitle ||
  (post.plainText
    ? `${post.plainText.slice(0, 180)}${post.plainText.length > 180 ? "…" : ""}`
    : "");
---

<article class:list={["article-card", { "is-featured": featured }]}>
  <div class="card-body">
    <div class="card-meta-top">
      {post.rubric && <span class="category-tag">{post.rubric}</span>}
      {post.genre && <span class="genre-badge meta-label">{post.genre}</span>}
    </div>

    <h2 class="card-title">
      <a href={`/articles/${encodeURIComponent(post.slug)}`}>{post.title}</a>
    </h2>

    {excerpt && <p class="card-excerpt">{excerpt}</p>}

    <div class="card-footer meta-label">
      {!hideAuthors && authors.length > 0 && (
        <span class="card-authors">{authors.map((a) => a.name).join(", ")} · </span>
      )}
      <time datetime={validDate.toISOString()}>{formattedDate}</time>
      {post.readingTime && <span> · {post.readingTime}</span>}
    </div>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
  }

  .article-card.is-featured {
    border-bottom: 2px solid var(--border-dark);
    padding-bottom: 1.5rem;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-meta-top {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }

  .genre-badge {
    color: var(--text-secondary);
    background-color: var(--surface-color);
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--border-color);
  }

  .card-title {
    margin: 0 0 0.6rem;
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .article-card.is-featured .card-title {
    font-size: clamp(1.65rem, 3.2vw, 2.35rem);
    line-height: 1.18;
  }

  .card-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--accent-color);
  }

  .card-excerpt {
    margin: 0 0 1rem;
    color: var(--text-secondary);
    line-height: 1.55;
    font-size: 0.98rem;
  }

  .article-card.is-featured .card-excerpt {
    font-size: 1.08rem;
  }

  .card-footer {
    margin-top: auto;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
