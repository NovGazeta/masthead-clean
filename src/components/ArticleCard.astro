---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, description, pubDate, author, category, image } = post.data;

const formattedDate = pubDate.toLocaleDateString("ru-RU", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<article class="card">
  {image && (
    <a href={`/posts/${post.id}`} class="card-img">
      <img src={image} alt={title} loading="lazy" />
    </a>
  )}
  <span class="category-tag">{category}</span>
  <h2>
    <a href={`/posts/${post.id}`}>{title}</a>
  </h2>
  <p>{description}</p>
  <div class="meta-label card-meta">
    {author} &bull; {formattedDate}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    padding-bottom: 1.5rem;
  }

  .card-img {
    margin-bottom: 1rem;
    overflow: hidden;
  }

  .card-img img {
    width: 100%;
    height: 210px;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .card:hover .card-img img {
    transform: scale(1.02);
  }

  .card h2 {
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.25;
    margin: 0.45rem 0 0.65rem;
  }

  .card p {
    color: var(--text-secondary);
    font-size: 0.98rem;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .card-meta {
    border-top: 1px solid var(--border-color);
    padding-top: 0.75rem;
  }
</style>
