---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

function buildPageHref(page: number): string {
  const url = new URL(baseUrl, "http://localhost");
  if (page <= 1) {
    url.searchParams.delete("page");
  } else {
    url.searchParams.set("page", String(page));
  }
  const search = url.searchParams.toString();
  return search ? `${url.pathname}?${search}` : url.pathname;
}

// Формируем список номеров с многоточиями для больших списков
function getPageNumbers(current: number, total: number): Array<number | "ellipsis"> {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  const pages: Array<number | "ellipsis"> = [1];

  if (current > 3) {
    pages.push("ellipsis");
  }

  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);

  for (let i = start; i <= end; i++) {
    pages.push(i);
  }

  if (current < total - 2) {
    pages.push("ellipsis");
  }

  pages.push(total);
  return pages;
}

const pages = getPageNumbers(currentPage, totalPages);
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Навигация по страницам">
    <div class="pagination-side">
      {currentPage > 1 ? (
        <a href={buildPageHref(currentPage - 1)} class="page-arrow meta-label" rel="prev">
          &larr; Предыдущая
        </a>
      ) : (
        <span class="page-arrow page-disabled meta-label" aria-disabled="true">
          &larr; Предыдущая
        </span>
      )}
    </div>

    <ol class="page-numbers">
      {pages.map((item) =>
        item === "ellipsis" ? (
          <li class="page-ellipsis meta-label" aria-hidden="true">
            &hellip;
          </li>
        ) : (
          <li>
            {item === currentPage ? (
              <span class="page-num is-current meta-label" aria-current="page">
                {item}
              </span>
            ) : (
              <a href={buildPageHref(item)} class="page-num meta-label">
                {item}
              </a>
            )}
          </li>
        ),
      )}
    </ol>

    <div class="pagination-side pagination-right">
      {currentPage < totalPages ? (
        <a href={buildPageHref(currentPage + 1)} class="page-arrow meta-label" rel="next">
          Следующая &rarr;
        </a>
      ) : (
        <span class="page-arrow page-disabled meta-label" aria-disabled="true">
          Следующая &rarr;
        </span>
      )}
    </div>
  </nav>
)}

<style>
  .pagination {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--border-dark);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .pagination-right {
    display: flex;
    justify-content: flex-end;
  }

  .page-numbers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    padding: 0 0.5rem;
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  a.page-num:hover {
    border-color: var(--border-dark);
    background-color: var(--surface-color);
    opacity: 1;
  }

  .page-num.is-current {
    border-color: var(--border-dark);
    background-color: var(--border-dark);
    color: var(--bg-color);
  }

  .page-ellipsis {
    padding: 0 0.35rem;
    color: var(--text-secondary);
  }

  .page-arrow {
    color: var(--text-primary);
    transition: color 0.2s ease;
  }

  a.page-arrow:hover {
    color: var(--accent-color);
    opacity: 1;
  }

  .page-disabled {
    color: var(--text-secondary);
    opacity: 0.45;
    cursor: default;
  }

  @media (max-width: 640px) {
    .pagination {
      grid-template-columns: 1fr 1fr;
      row-gap: 1rem;
    }

    .page-numbers {
      grid-column: 1 / -1;
      justify-content: center;
      order: -1;
    }
  }
</style>
