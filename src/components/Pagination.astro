---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath?: string; // например: "" (корень), "/rubric/design", "/tag/astro"
  query?: Record<string, string | number | undefined | null>; // например: { q: "turso" }
  siblingCount?: number;
}

const { currentPage, totalPages, basePath = "", query, siblingCount = 1 } = Astro.props;

if (!Number.isFinite(totalPages) || totalPages <= 1) {
  return;
}

const safeCurrent = Math.min(totalPages, Math.max(1, Math.floor(currentPage)));
const hasPrev = safeCurrent > 1;
const hasNext = safeCurrent < totalPages;

const normalizedBase =
  !basePath || basePath === "/" ? "" : `/${basePath.replace(/^\/+|\/+$/g, "")}`;

function buildQueryString(pageNum: number): string {
  const params = new URLSearchParams();

  if (query) {
    for (const [key, val] of Object.entries(query)) {
      if (val !== undefined && val !== null && String(val).trim() !== "") {
        params.set(key, String(val));
      }
    }
  }

  // Если используется query-режим (например, ?q=...&page=2), добавляем page
  // Для ЧПУ-путей page=1 на /page/2 обычно не нужен, но если basePath пустой и есть query — аккуратно обрабатываем
  if (normalizedBase === "" && query && Object.keys(query).length > 0) {
    if (pageNum > 1) {
      params.set("page", String(pageNum));
    }
    const qs = params.toString();
    return qs ? `/?${qs}` : "/";
  }

  const pagePrefix = pageNum <= 1 ? normalizedBase || "/" : `${normalizedBase}/${pageNum}`;
  const qs = params.toString();
  return qs ? `${pagePrefix}?${qs}` : pagePrefix;
}

type PageToken = number | "ellipsis-prev" | "ellipsis-next";

function buildPageTokens(current: number, total: number, siblings: number): PageToken[] {
  const totalNumbers = siblings * 2 + 5; // первая, последняя, текущая + соседи + 2 многоточия
  if (total <= totalNumbers) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  const leftSibling = Math.max(current - siblings, 2);
  const rightSibling = Math.min(current + siblings, total - 1);

  const showLeftEllipsis = leftSibling > 2;
  const showRightEllipsis = rightSibling < total - 1;

  const tokens: PageToken[] = [1];

  if (showLeftEllipsis) {
    tokens.push("ellipsis-prev");
  }

  for (let p = leftSibling; p <= rightSibling; p++) {
    tokens.push(p);
  }

  if (showRightEllipsis) {
    tokens.push("ellipsis-next");
  }

  tokens.push(total);
  return tokens;
}

const pageTokens = buildPageTokens(safeCurrent, totalPages, Math.max(0, siblingCount));
---

<nav class="pagination" aria-label="Навигация по страницам">
  {hasPrev ? (
    <a class="pagination-btn meta-label" href={buildQueryString(safeCurrent - 1)}>
      &larr; Назад
    </a>
  ) : (
    <span class="pagination-btn meta-label is-disabled" aria-disabled="true">
      &larr; Назад
    </span>
  )}

  <div class="pagination-pages">
    {pageTokens.map((token) => {
      if (token === "ellipsis-prev" || token === "ellipsis-next") {
        return (
          <span class="page-ellipsis meta-label" aria-hidden="true">
            &hellip;
          </span>
        );
      }

      if (token === safeCurrent) {
        return (
          <span class="page-number meta-label is-current" aria-current="page">
            {token}
          </span>
        );
      }

      return (
        <a class="page-number meta-label" href={buildQueryString(token)}>
          {token}
        </a>
      );
    })}
  </div>

  {hasNext ? (
    <a class="pagination-btn meta-label" href={buildQueryString(safeCurrent + 1)}>
      Вперёд &rarr;
    </a>
  ) : (
    <span class="pagination-btn meta-label is-disabled" aria-disabled="true">
      Вперёд &rarr;
    </span>
  )}
</nav>

<style>
  .pagination {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pagination-pages {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .pagination-btn,
  .page-number,
  .page-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 0.75rem;
    text-decoration: none;
  }

  .pagination-btn,
  .page-number {
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .pagination-btn:hover,
  .page-number:hover {
    border-color: var(--border-dark);
    background-color: var(--surface-color);
  }

  .page-number.is-current {
    border-color: var(--border-dark);
    background-color: var(--border-dark);
    color: var(--bg-color);
  }

  .pagination-btn.is-disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  .page-ellipsis {
    min-width: 28px;
    padding: 0 0.25rem;
    color: var(--text-secondary);
    user-select: none;
  }

  @media (max-width: 600px) {
    .pagination {
      flex-direction: column;
      align-items: stretch;
    }

    .pagination-pages {
      justify-content: center;
    }
  }
</style>
