---
interface Props {
  currentPage: number;
  totalPages: number;
  /** Базовый путь, например "/" или "/archive". По умолчанию берется из Astro.url.pathname */
  basePath?: string;
  /** Дополнительные query-параметры для сохранения (например, { year: 2026 } или { q: "поиск" }) */
  queryParams?: Record<string, string | number | undefined>;
  ariaLabel?: string;
}

const {
  currentPage,
  totalPages,
  basePath = Astro.url.pathname,
  queryParams = {},
  ariaLabel = "Навигация по страницам",
} = Astro.props;

if (totalPages <= 1) {
  return;
}

const safePage = Math.min(Math.max(1, currentPage), totalPages);

function getPageNumbers(current: number, total: number): (number | "...")[] {
  const delta = 2;
  const range: (number | "...")[] = [];
  for (let i = 1; i <= total; i++) {
    if (i === 1 || i === total || (i >= current - delta && i <= current + delta)) {
      range.push(i);
    } else if (range[range.length - 1] !== "...") {
      range.push("...");
    }
  }
  return range;
}

function buildPageHref(page: number): string {
  const params = new URLSearchParams();

  for (const [key, value] of Object.entries(queryParams)) {
    if (value !== undefined && value !== "") {
      params.set(key, String(value));
    }
  }

  if (page > 1) {
    params.set("page", String(page));
  }

  const queryString = params.toString();
  return queryString ? `${basePath}?${queryString}` : basePath;
}

const pageNumbers = getPageNumbers(safePage, totalPages);
---

<nav class="pagination" aria-label={ariaLabel}>
  {safePage > 1 ? (
    <a href={buildPageHref(safePage - 1)} class="page-link">
      &larr; Назад
    </a>
  ) : (
    <span class="page-link disabled">&larr; Назад</span>
  )}

  <div class="page-numbers">
    {pageNumbers.map((p) =>
      p === "..." ? (
        <span class="page-dots meta-label">...</span>
      ) : (
        <a
          href={buildPageHref(p)}
          class={`page-num meta-label ${p === safePage ? "is-active" : ""}`}
          aria-current={p === safePage ? "page" : undefined}
        >
          {p}
        </a>
      ),
    )}
  </div>

  {safePage < totalPages ? (
    <a href={buildPageHref(safePage + 1)} class="page-link">
      Вперед &rarr;
    </a>
  ) : (
    <span class="page-link disabled">Вперед &rarr;</span>
  )}
</nav>

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--border-dark);
  }

  .page-numbers {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 0.4rem;
    border: 1px solid var(--border-color);
    background-color: var(--surface-color);
    color: var(--text-primary);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .page-num:hover {
    border-color: var(--border-dark);
    color: var(--accent-color);
    opacity: 1;
  }

  .page-num.is-active {
    background-color: var(--border-dark);
    color: var(--accent-color);
    border-color: var(--border-dark);
    font-weight: 500;
  }

  .page-dots {
    padding: 0 0.2rem;
    color: var(--text-secondary);
  }

  .page-link {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--text-primary);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-color);
    background-color: var(--surface-color);
    transition: all 0.2s ease;
  }

  .page-link:hover:not(.disabled) {
    border-color: var(--border-dark);
    color: var(--accent-color);
    opacity: 1;
  }

  .page-link.disabled {
    opacity: 0.4;
    cursor: not-allowed;
    background-color: transparent;
  }

  @media (max-width: 768px) {
    .pagination {
      margin-top: 2.5rem;
    }
  }

  @media (max-width: 600px) {
    .pagination {
      flex-direction: column;
      gap: 1rem;
    }

    .page-numbers {
      order: -1;
    }
  }
</style>
