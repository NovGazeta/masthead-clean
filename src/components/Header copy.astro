---
const today = new Date().toLocaleDateString("ru-RU", {
    weekday: "long",
    year: "numeric",
    month: "long",
    day: "numeric",
});

const categories = [
    { name: "Все материалы", slug: "/" },
    { name: "Культура", slug: "/category/culture" },
    { name: "Технологии", slug: "/category/technology" },
    { name: "Эссе", slug: "/category/essays" },
    { name: "Дизайн", slug: "/category/design" },
];
---

<header class="masthead">
    <div class="container">
        <div class="top-bar">
            <span class="meta-label">{today}</span>
            <span class="meta-label">Выпуск № 42 &bull; Независимое издание</span>
        </div>

        <div class="brand-area">
            <a href="/" class="logo">
                THE MASTHEAD
            </a>
            <p class="tagline">Журнал о цифровом ремесле, культуре и медленном чтении</p>
        </div>

        <nav class="nav-bar" aria-label="Рубрики">
            <ul>
                {categories.map((cat) => (
                    <li>
                        <a href={cat.slug} class="meta-label">
                            {cat.name}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>

<style>
    .masthead {
        padding-top: 1rem;
        margin-bottom: 2.5rem;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border-color);
    }

    .brand-area {
        text-align: center;
        padding: 2.25rem 0;
        border-bottom: 2px solid var(--border-dark);
    }

    .logo {
        font-family: var(--font-serif);
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 500;
        letter-spacing: -0.03em;
        line-height: 1;
        display: block;
    }

    .tagline {
        font-style: italic;
        color: var(--text-secondary);
        margin-top: 0.65rem;
        font-size: 1.05rem;
    }

    .nav-bar {
        border-bottom: 1px solid var(--border-dark);
        padding: 0.75rem 0;
    }

    .nav-bar ul {
        list-style: none;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 2rem;
    }

    .nav-bar a {
        color: var(--text-primary);
    }

    .nav-bar a:hover {
        color: var(--accent-color);
        opacity: 1;
    }
</style>
